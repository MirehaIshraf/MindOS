{
  "manifest_version": 3,
  "name": "MindOS Browser Connector",
  "version": "0.1.0",
  "description": "Save selected browser pages and research context to MindOS.",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "http://*/*", "https://*/*"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "MindOS"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  }
}
