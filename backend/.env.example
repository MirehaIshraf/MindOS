APP_NAME=MindOS
APP_ENV=development
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/mindos.db
FRONTEND_URL=http://localhost:5173
ENABLE_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_THINKING_MODE=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=
SELECTED_CHAT_MODEL=ollama-qwen3
ENABLE_EMBEDDINGS=true
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_PATH=data/chroma
SEMANTIC_SEARCH_DEFAULT=false
EMBEDDING_TEXT_MAX_CHARS=4000
CHAT_CONTEXT_DIRECT_LIMIT=4
CHAT_CONTEXT_RELATED_PER_EVENT=1
CHAT_CONTEXT_MAX_CHARS_PER_EVENT=700
CHAT_CONTEXT_MAX_TOTAL_CHARS=6000
CHAT_HISTORY_LIMIT=4
